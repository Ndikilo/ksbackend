# kanasante/api environment schema (varlock / @env-spec).
# This file is COMMITTED and contains NO secret values — only the shape, types,
# docs, and safe local defaults. Real secrets go in .env.local (git-ignored).
#
# Local dev uses the SAME real drivers as prod, pointed at local emulators:
# Postgres (docker compose), S3 (LocalStack), email (a personal Resend account).
# See docs/local-dev.md for the one-time LocalStack + Resend setup.

# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts)
# ---

# Which environment resolution to use.
# @type=enum(local, test, ci, staging, prod)
# @required
APP_ENV=local

# HTTP port the API listens on.
# @type=number
PORT=5000

# Postgres connection string. Defaults to the docker-compose database for local dev.
# @type=string(startsWith=postgres)
# @sensitive @required=forEnv(prod)
DATABASE_URL=postgres://kanasante:kanasante@localhost:5432/kanasante

# Postgres connection pool size, per app instance.
# @type=number
DB_POOL_MAX=10

# better-auth signing/encryption secret (>=32 chars). Only required in prod.
# Generate with: openssl rand -base64 32
# @sensitive @required=forEnv(prod)
# @docs(https://www.better-auth.com/docs/installation)
BETTER_AUTH_SECRET=2732267d8bf39f56cf67e7e904b285d22732ff93f3f0087fad2702352941105c

# Public base URL of this API (used by better-auth).
# @type=string
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of origins allowed by CORS (cookies enabled).
# @type=string
CORS_ORIGINS=http://localhost:3000

# Rate limiting (per instance): max requests per window per client.
# @type=number
RATE_LIMIT_MAX=300
# @type=number
RATE_LIMIT_WINDOW_SECONDS=60

# In-process cache bound (entries). See src/infra/cache.ts.
# @type=number
CACHE_MAX_ENTRIES=1000

# Optional Redis/KeyDB URL for caching + rate limiting. The app runs perfectly
# WITHOUT it (in-process fallbacks) — even in production. Leave blank to disable.
# @sensitive @required=false
REDIS_URL=

# Default locale when no (or an unsupported) Accept-Language is sent.
# @type=enum(en, fr)
DEFAULT_LOCALE=en

# --- Email (Resend) --------------------------------------------------------
# Real Resend in every environment. Locally, use a PERSONAL Resend account's API
# key (docs/local-dev.md); until you set one, boot works but sends fail. In
# Resend's sandbox you can only deliver to your own verified address.
# @sensitive @required=forEnv(prod)
# @docs(https://resend.com/docs)
RESEND_API_KEY=
# @type=string
EMAIL_FROM=KanaSanté <no-reply@kanasante.com>
# Override the Resend API base URL. LEAVE UNSET in prod. Locally, point it at
# resend-local (http://localhost:8005, started via `bun run email:local`) to
# capture email in its dashboard instead of sending. See docs/local-dev.md.
RESEND_BASE_URL=

# --- File storage (AWS S3, one bucket) -------------------------------------
# Local dev talks to LocalStack (see docs/local-dev.md), so these are set locally
# too — the code path is identical to prod, only the endpoint differs.
# @required=forEnv(prod)
S3_BUCKET=kanasante-dev
# @required=forEnv(prod)
S3_REGION=us-east-1
# Standard AWS credentials read by the SDK's default chain (not app config).
# Locally these are LocalStack's dummy values (any non-empty string works).
# @sensitive @required=forEnv(prod)
AWS_ACCESS_KEY_ID=localstack-access-key-id
# @sensitive @required=forEnv(prod)
AWS_SECRET_ACCESS_KEY=localstack-secret-access-key
# Custom S3 endpoint. Honored natively by the AWS SDK. LEAVE UNSET in prod (real
# AWS); locally set to LocalStack, e.g. http://localhost:4566
AWS_ENDPOINT_URL_S3=
# Path-style S3 addressing (host/bucket/key). Required for LocalStack; leave
# false/unset for real AWS (virtual-host).
# @type=boolean
S3_FORCE_PATH_STYLE=false
# Upload links remain short-lived; patient-facing photo/document reads are cached longer.
# @type=number
S3_UPLOAD_PRESIGN_TTL_SECONDS=300
# @type=number
S3_DOWNLOAD_PRESIGN_TTL_SECONDS=3600

# KanaSanté's appointment commission in basis points (2000 = 20%).
# @type=number
PLATFORM_COMMISSION_BPS=2000

# --- At-rest encryption (NIC/CMC numbers) — 32-byte base64 -----------------
# Dev defaults are non-secret; production MUST override with real random keys:
#   openssl rand -base64 32
# @sensitive @required=forEnv(prod)
DATA_ENCRYPTION_KEY=a2FuYXNhbnRlLWRldi1lbmNyeXB0aW9uLWtleS0zMmI=
# @sensitive @required=forEnv(prod)
DATA_HMAC_KEY=a2FuYXNhbnRlLWRldi1obWFjLWtleS0wMDAwMDAwMzI=

# --- Admin seed (used by `bun run db:seed`) --------------------------------
# @type=string
ADMIN_SEED_EMAIL=
# @sensitive @required=false
ADMIN_SEED_PASSWORD=
# Optional existing practitioner account to enrich with deterministic demo detail data.
# @type=string
DEMO_PRACTITIONER_EMAIL=
