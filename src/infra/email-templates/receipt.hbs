<h1 style="margin:0 0 12px;font-size:20px;font-weight:700;">{{heading}}</h1>
<p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#4a5568;">{{intro}}</p>
<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  style="margin:0 0 20px;border-top:1px solid #eef0f3;"
>
  {{#each rows}}
    <tr>
      <td style="padding:10px 0;border-bottom:1px solid #eef0f3;font-size:13px;color:#8a94a6;">
        {{label}}
      </td>
      <td
        align="right"
        style="padding:10px 0;border-bottom:1px solid #eef0f3;font-size:14px;font-weight:600;color:#1a1a2e;"
      >
        {{value}}
      </td>
    </tr>
  {{/each}}
</table>
<p style="margin:0;font-size:13px;line-height:1.6;color:#8a94a6;">{{closing}}</p>