{
  "name": "@kanasante/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "varlock run -- bun run --watch src/server.ts",
    "start": "varlock run -- bun run src/server.ts",
    "infra:up": "bash scripts/infra-up",
    "infra:down": "docker compose down",
    "email:local": "bunx resend-local",
    "typecheck": "tsc --noEmit",
    "check:structure": "bun run scripts/check-structure.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --project unit --project api",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:integration": "vitest run --project integration",
    "check": "bun run typecheck && bun run check:structure && bun run lint && bun run format:check && bun run test",
    "env:check": "varlock load",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:studio": "varlock run -- drizzle-kit studio",
    "db:seed": "varlock run -- bun scripts/seed.ts",
    "setup": "bash scripts/setup",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@effect/sql": "^0.52.0",
    "@effect/sql-drizzle": "^0.51.0",
    "@effect/sql-pg": "^0.53.0",
    "@hono/zod-openapi": "^1.5.1",
    "@scalar/hono-api-reference": "^0.11.12",
    "better-auth": "^1.6.25",
    "effect": "^3.22.1",
    "evlog": "^2.24.0",
    "handlebars": "^4.7.9",
    "hono": "^4.13.0",
    "resend": "^6.18.1",
    "uuid": "^14.0.1",
    "varlock": "^1.16.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@oxlint/plugins": "1.78.0",
    "@testcontainers/localstack": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "lefthook": "^1.11.0",
    "oxfmt": "^0.62.0",
    "oxlint": "1.78.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
